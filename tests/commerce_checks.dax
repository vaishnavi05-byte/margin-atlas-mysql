EVALUATE ROW("Gross Sales",[Gross Sales],"Sales Before Refund",[Sales Before Refund],"Discount Rate",[Discount Rate],"Sales Per Delivered Order",[Sales Per Delivered Order],"Contribution Per Placed Order",[Contribution Per Placed Order],"After Marketing Margin",[After Marketing Margin],"Marketing Per Placed Order",[Marketing Per Placed Order],"Shipped Orders",[Shipped Orders],"Cancelled Orders",[Cancelled Orders],"Cancellation Rate",[Cancellation Rate],"Fulfilment Per Shipped Order",[Fulfilment Per Shipped Order],"Fees Per Delivered Order",[Fees Per Delivered Order],"Variable Service Cost",[Variable Service Cost],"Service Cost Per Placed Order",[Service Cost Per Placed Order],"Negative Order Rate",[Negative Order Rate],"Observed Returned Orders",[Observed Returned Orders],"Reverse Cost Per Returned Order",[Reverse Cost Per Returned Order],"Discounted Delivered Orders",[Discounted Delivered Orders],"Item Sales Before Refund",[Item Sales Before Refund],"Item Product Cost",[Item Product Cost],"Item Merchandise Margin",[Item Merchandise Margin],"Item Merchandise Margin Rate",[Item Merchandise Margin Rate],"Recognized Units",[Recognized Units],"Delivered Item Orders",[Delivered Item Orders],"Units Per Item Order",[Units Per Item Order])
EVALUATE SUMMARIZECOLUMNS(DimChannel[channel],"Orders",[Orders],"Net Sales",[Net Sales],"Marketing Spend",[Marketing Spend],"Contribution After Marketing",[Contribution After Marketing],"After Marketing Margin",[After Marketing Margin],"Marketing Per Placed Order",[Marketing Per Placed Order])
EVALUATE SUMMARIZECOLUMNS(FactOrders[discount_band],"Orders",[Orders],"Net Sales",[Net Sales],"Contribution Before Marketing",[Contribution Before Marketing],"Mature Orders",[Mature Orders],"Mature Return Rate",[Mature Return Rate],"Negative Order Rate",[Negative Order Rate])
EVALUATE SUMMARIZECOLUMNS(FactOrders[payment_method],"Orders",[Orders],"Shipped Orders",[Shipped Orders],"Cancelled Orders",[Cancelled Orders],"Cancellation Rate",[Cancellation Rate],"Variable Service Cost",[Variable Service Cost],"Fulfilment Per Shipped Order",[Fulfilment Per Shipped Order],"Fees Per Delivered Order",[Fees Per Delivered Order])
EVALUATE SUMMARIZECOLUMNS(DimProduct[product_id],"Item Sales Before Refund",[Item Sales Before Refund],"Item Product Cost",[Item Product Cost],"Item Merchandise Margin",[Item Merchandise Margin],"Item Merchandise Margin Rate",[Item Merchandise Margin Rate],"Recognized Units",[Recognized Units],"Delivered Item Orders",[Delivered Item Orders],"Units Per Item Order",[Units Per Item Order])
EVALUATE CALCULATETABLE(ROW("Marketing Must Be Blank",[Marketing Spend],"After Marketing Must Be Blank",[Contribution After Marketing],"Item Sales Before Refund",[Item Sales Before Refund],"Orders Stay At Order Grain",[Orders]),TREATAS({101},DimProduct[product_id]))
EVALUATE CALCULATETABLE(ROW("Marketing Must Be Blank",[Marketing Spend],"After Marketing Must Be Blank",[Contribution After Marketing]),TREATAS({"21-30%"},FactOrders[discount_band]))
EVALUATE CALCULATETABLE(ROW("Cancelled Orders",[Cancelled Orders],"Cancellation Rate",[Cancellation Rate],"Shipped Orders",[Shipped Orders],"Fulfilment Per Shipped Order",[Fulfilment Per Shipped Order]),TREATAS({"Delivered"},FactOrders[status]))
