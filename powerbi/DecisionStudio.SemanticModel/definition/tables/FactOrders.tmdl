table FactOrders
	lineageTag: bf039067-de3e-4da3-b705-2836fdaadcbb

	measure Orders = COUNTROWS(FactOrders)
		formatString: #,0
		lineageTag: 33d89861-406e-4373-99a8-1f7a050ee63d

	measure 'Net Sales' = DIVIDE(SUM(FactOrders[net_sales_paise]),100)
		formatString: "INR "#,0;("INR "#,0);"INR "0
		lineageTag: 712c594c-51c8-4d83-9776-2ba156746dd0

	measure 'Contribution Before Marketing' = DIVIDE(SUM(FactOrders[contribution_before_marketing_paise]),100)
		formatString: "INR "#,0;("INR "#,0);"INR "0
		lineageTag: 33f31bea-8808-4d97-9254-5ba5f5f127c7

	measure 'Contribution Margin Before Marketing' = DIVIDE([Contribution Before Marketing],[Net Sales])
		formatString: 0.0%
		lineageTag: b8171d09-76c0-4bae-a4df-80cb06db2778

	measure 'Negative Contribution Exposure' = DIVIDE(SUM(FactOrders[negative_contribution_paise]),100)
		formatString: "INR "#,0;("INR "#,0);"INR "0
		lineageTag: 7edea32a-ce00-456d-8934-2a0d4e71acb2

	measure 'Negative Contribution Orders' = SUM(FactOrders[negative_order])
		formatString: #,0
		lineageTag: e8fac53d-ba81-42e6-9413-83b6c82a3546

	measure 'Mature Orders' = SUM(FactOrders[return_mature])
		formatString: #,0
		lineageTag: a3c5c311-eac6-40b8-8506-360f5875a769

	measure 'Mature Returns' = SUM(FactOrders[mature_returns])
		formatString: #,0
		lineageTag: 2e10e803-7c63-4c4e-8748-15dcedbaebab

	measure 'Mature Return Rate' = DIVIDE([Mature Returns],[Mature Orders])
		formatString: 0.0%
		lineageTag: e1479cea-8078-4418-a608-4640bddca039

	measure 'Delivery Eligible Orders' = SUM(FactOrders[delivery_eligible])
		formatString: #,0
		lineageTag: 4a13c6e5-a27f-4296-93de-55f8a87ed63b

	measure 'Late Orders' = SUM(FactOrders[late_flag])
		formatString: #,0
		lineageTag: 47d3353b-db13-453a-ad69-fec92a87a238

	measure 'Late Rate' = DIVIDE([Late Orders],[Delivery Eligible Orders])
		formatString: 0.0%
		lineageTag: 36bddaab-f49c-4276-b3a1-e8cb3dfcbe6f

	measure 'Mature Late Rate' = DIVIDE(SUM(FactOrders[mature_late_orders]),[Mature Orders])
		formatString: 0.0%
		lineageTag: 7ecc92ed-48f8-4146-893b-ec1450b92dd5

	measure Discounts = DIVIDE(SUM(FactOrders[discount_paise]),100)
		formatString: "INR "#,0;("INR "#,0);"INR "0
		lineageTag: 890b7a4e-8925-46e7-aa2c-d08b6e5c4c3b

	measure Refunds = DIVIDE(SUM(FactOrders[refund_paise]),100)
		formatString: "INR "#,0;("INR "#,0);"INR "0
		lineageTag: 02baaffe-95a8-4fdb-bad6-84fa3b76bd26

	measure 'Net Product Cost' = DIVIDE(SUM(FactOrders[net_product_cost_paise]),100)
		formatString: "INR "#,0;("INR "#,0);"INR "0
		lineageTag: 633836ce-c05c-46e3-b96a-81f74901f6fe

	measure Fulfilment = DIVIDE(SUM(FactOrders[fulfilment_paise]),100)
		formatString: "INR "#,0;("INR "#,0);"INR "0
		lineageTag: d622e777-0f17-4fa3-921d-93028cb3d948

	measure Fees = DIVIDE(SUM(FactOrders[payment_fee_paise]),100)
		formatString: "INR "#,0;("INR "#,0);"INR "0
		lineageTag: dce1bc69-c980-4066-8ced-c89f0d6d6c5e

	measure 'Reverse Logistics' = DIVIDE(SUM(FactOrders[reverse_logistics_paise]),100)
		formatString: "INR "#,0;("INR "#,0);"INR "0
		lineageTag: 6964363a-a38f-49b9-9c02-397108dff253

	measure 'Selected Metric' = SWITCH(SELECTEDVALUE(Metric[Label],"Net sales"),"Net sales",[Net Sales],"Contribution before marketing",[Contribution Before Marketing],[Negative Contribution Exposure])
		formatString: "INR "#,0;("INR "#,0);"INR "0
		lineageTag: a9a84c58-046b-4f26-9c8e-71cb6021d47f

	measure 'Sample Eligible' = INT([Mature Orders]>=SELECTEDVALUE(MinimumSample[Orders],100))
		formatString: 0
		lineageTag: 6dbee279-88b4-4321-bbf4-4bf3bf0484f8

	measure 'Priority Rank' = IF(HASONEVALUE(DimSegment[segment_key]) && [Sample Eligible]=1,RANKX(FILTER(ALLSELECTED(DimSegment),CALCULATE([Sample Eligible])=1),[Negative Contribution Exposure],,DESC,Dense))
		formatString: 0
		lineageTag: c1e537ce-ce4c-4844-ad07-818462a3c6f5

	measure 'Return Rate Low 95' = VAR n=[Mature Orders] VAR p=[Mature Return Rate] VAR z=1.959963984540054 RETURN IF(n>0,DIVIDE(p+z*z/(2*n)-z*SQRT(p*(1-p)/n+z*z/(4*n*n)),1+z*z/n))
		formatString: 0.0%
		lineageTag: 03326026-965e-4056-9004-b2935cdfdef6

	measure 'Return Rate High 95' = VAR n=[Mature Orders] VAR p=[Mature Return Rate] VAR z=1.959963984540054 RETURN IF(n>0,DIVIDE(p+z*z/(2*n)+z*SQRT(p*(1-p)/n+z*z/(4*n*n)),1+z*z/n))
		formatString: 0.0%
		lineageTag: b4ed7c2b-c97e-49a3-9607-003c4cccaa43

	measure 'Scenario Return Cost Base' = DIVIDE(SUM(FactOrders[scenario_return_base_paise]),100)
		formatString: "INR "#,0;("INR "#,0);"INR "0
		lineageTag: 6d03e31f-771f-4760-9fe4-ca91a159fe8e

	measure 'Modeled Avoided Return Cost' = [Scenario Return Cost Base]*DIVIDE(SELECTEDVALUE(Recovery[Percent],15),100)
		formatString: "INR "#,0;("INR "#,0);"INR "0
		lineageTag: 5383e805-918d-408b-aafe-11ea53f774d3

	measure 'Scenario Intervention Cost' = [Mature Orders]*SELECTEDVALUE(InterventionCost[INR],0)
		formatString: "INR "#,0;("INR "#,0);"INR "0
		lineageTag: 35e1643a-1157-4ac9-9068-24daf3a99ed9

	measure 'Modeled Net Contribution Change' = [Modeled Avoided Return Cost]-[Scenario Intervention Cost]
		formatString: "INR "#,0;("INR "#,0);"INR "0
		lineageTag: 66abe558-7c46-4829-a7ac-3ad836856bac

	measure 'Break Even Cost Per Mature Order' = DIVIDE([Modeled Avoided Return Cost],[Mature Orders])
		formatString: "INR "#,0;("INR "#,0);"INR "0
		lineageTag: f8006ad5-ed97-4418-9acd-44cfea3fe626

	measure 'Marketing Spend' = IF(ISFILTERED(DimProduct)||ISFILTERED(FactItems[product_id])||ISFILTERED(FactItems[order_id])||ISFILTERED(FactOrders[discount_band])||ISFILTERED(DimCategory)||ISFILTERED(DimCustomer)||ISFILTERED(DimSegment)||ISFILTERED(FactOrders[order_id])||ISFILTERED(FactOrders[payment_method])||ISFILTERED(FactOrders[status]),BLANK(),DIVIDE(SUM(FactMarketing[spend_paise]),100))
		formatString: "INR "#,0;("INR "#,0);"INR "0
		lineageTag: 17643567-3645-4637-9c15-880826ef575e

	measure 'Contribution After Marketing' = IF(NOT ISBLANK([Marketing Spend]),[Contribution Before Marketing]-[Marketing Spend])
		formatString: "INR "#,0;("INR "#,0);"INR "0
		lineageTag: 22bb3aa1-4888-4971-b63b-4d5383c2e78a

	measure 'Eligible Cohort Customers' = COUNTROWS(Cohorts)
		formatString: #,0
		lineageTag: 4fe97ac4-a470-4e1c-a7bd-f63a09152623

	measure 'Repeat Customers 90d' = SUM(Cohorts[repeat_90d])
		formatString: #,0
		lineageTag: 32f5199c-7983-4d9a-a9f7-bc6fbc56fbf3

	measure 'Repeat Rate 90d' = DIVIDE([Repeat Customers 90d],[Eligible Cohort Customers])
		formatString: 0.0%
		lineageTag: 792dcb8f-ad69-47f1-968e-1dbfccd2dc90

	measure 'Sensitivity Net Change' = [Scenario Return Cost Base] * DIVIDE(SELECTEDVALUE(SensitivityRecovery[Percent]),100) - [Scenario Intervention Cost]
		formatString: "INR "#,0;("INR "#,0);"INR "0
		lineageTag: 5943e514-372b-4b6f-8ff5-ebab1e2b151d

	measure 'Gross Sales' = DIVIDE(SUM(FactOrders[gross_paise]),100)
		formatString: "INR "#,0;("INR "#,0);"INR "0
		lineageTag: c8c3b474-91ec-4e38-b88d-677c70e369fa

	measure 'Sales Before Refund' = [Gross Sales]-[Discounts]
		formatString: "INR "#,0;("INR "#,0);"INR "0
		lineageTag: 6a67cdbc-60b3-4a7b-8fcc-6e0cd2e0335b

	measure 'Discount Rate' = DIVIDE([Discounts],[Gross Sales])
		formatString: 0.0%
		lineageTag: f277977b-74d7-4333-99f4-c78db172ef95

	measure 'Sales Per Delivered Order' = DIVIDE([Net Sales],[Delivery Eligible Orders])
		formatString: "INR "#,0;("INR "#,0);"INR "0
		lineageTag: 957f065d-d8b3-4236-81c0-0f5f3d20a0e9

	measure 'Contribution Per Placed Order' = DIVIDE([Contribution Before Marketing],[Orders])
		formatString: "INR "#,0;("INR "#,0);"INR "0
		lineageTag: 3c4ff0fa-e599-49b7-8ee4-e84c948e43df

	measure 'After Marketing Margin' = DIVIDE([Contribution After Marketing],[Net Sales])
		formatString: 0.0%
		lineageTag: cafe86f8-c198-40dc-8ef4-e6d6f426c5cc

	measure 'Marketing Per Placed Order' = DIVIDE([Marketing Spend],[Orders])
		formatString: "INR "#,0;("INR "#,0);"INR "0
		lineageTag: b91d631f-701b-42c8-b44f-e9a5825cee08

	measure 'Shipped Orders' = CALCULATE([Orders],KEEPFILTERS(FactOrders[status]<>"Cancelled"))
		formatString: #,0
		lineageTag: 967a1bc7-7669-4129-9423-630215608598

	measure 'Cancelled Orders' = CALCULATE([Orders],KEEPFILTERS(FactOrders[status]="Cancelled"))
		formatString: #,0
		lineageTag: 9b41bd19-8ca0-4dc4-8a5f-9f31bc157e24

	measure 'Cancellation Rate' = DIVIDE([Cancelled Orders],[Orders])
		formatString: 0.0%
		lineageTag: 41a633ba-0117-4951-815a-5d03ba4b1136

	measure 'Fulfilment Per Shipped Order' = DIVIDE([Fulfilment],[Shipped Orders])
		formatString: "INR "#,0;("INR "#,0);"INR "0
		lineageTag: 9defeba4-9f34-4b1d-be10-18ce055b4a70

	measure 'Fees Per Delivered Order' = DIVIDE([Fees],[Delivery Eligible Orders])
		formatString: "INR "#,0;("INR "#,0);"INR "0
		lineageTag: 0ccb00e8-e1b3-4e5a-aea2-266ef258b4d9

	measure 'Variable Service Cost' = [Fulfilment]+[Fees]+[Reverse Logistics]
		formatString: "INR "#,0;("INR "#,0);"INR "0
		lineageTag: c5e11bac-ba33-4151-927c-7adfba424594

	measure 'Service Cost Per Placed Order' = DIVIDE([Variable Service Cost],[Orders])
		formatString: "INR "#,0;("INR "#,0);"INR "0
		lineageTag: 791f97f0-069a-4d17-bb88-0c1e2aeea330

	measure 'Negative Order Rate' = DIVIDE([Negative Contribution Orders],[Orders])
		formatString: 0.0%
		lineageTag: 75846fb9-2ea0-4d93-bbbd-9c2ea09d9ad7

	measure 'Observed Returned Orders' = SUM(FactOrders[return_flag])
		formatString: #,0
		lineageTag: d29bbc03-e2f1-412c-a296-f305bde100ca

	measure 'Reverse Cost Per Returned Order' = DIVIDE([Reverse Logistics],[Observed Returned Orders])
		formatString: "INR "#,0;("INR "#,0);"INR "0
		lineageTag: 5651075c-73c9-4285-a860-874702888eb3

	measure 'Discounted Delivered Orders' = CALCULATE([Orders],KEEPFILTERS(FactOrders[delivery_eligible]=1),KEEPFILTERS(FactOrders[discount_paise]>0))
		formatString: #,0
		lineageTag: 2a073d38-e720-41e1-a479-700bc0f1bcf8

	measure 'Item Sales Before Refund' = DIVIDE(SUM(FactItems[sales_before_refund_paise]),100)
		formatString: "INR "#,0;("INR "#,0);"INR "0
		lineageTag: aa55d69c-021c-4ea8-9b45-807c2e880ee1

	measure 'Item Product Cost' = DIVIDE(SUM(FactItems[cogs_paise]),100)
		formatString: "INR "#,0;("INR "#,0);"INR "0
		lineageTag: 307e9703-0f1b-4535-a775-d1a3caa4b05c

	measure 'Item Merchandise Margin' = DIVIDE(SUM(FactItems[merchandise_margin_paise]),100)
		formatString: "INR "#,0;("INR "#,0);"INR "0
		lineageTag: 2b001cf5-b961-4e77-9529-62439e77f0f9

	measure 'Item Merchandise Margin Rate' = DIVIDE([Item Merchandise Margin],[Item Sales Before Refund])
		formatString: 0.0%
		lineageTag: 01e46638-34b3-4c37-9267-6be581cc063d

	measure 'Recognized Units' = SUM(FactItems[recognized_units])
		formatString: #,0
		lineageTag: 9b39aa33-e002-42d5-94b4-ecc809cf0bae

	measure 'Delivered Item Orders' = CALCULATE(DISTINCTCOUNT(FactItems[order_id]),KEEPFILTERS(FactOrders[delivery_eligible]=1))
		formatString: #,0
		lineageTag: 95d53d7d-bb09-42b7-b6d0-b50cf56dc7e7

	measure 'Units Per Item Order' = DIVIDE([Recognized Units],[Delivered Item Orders])
		formatString: 0.00
		lineageTag: 2b60eef6-6c2e-45d7-8e80-b831ddd74ef1

