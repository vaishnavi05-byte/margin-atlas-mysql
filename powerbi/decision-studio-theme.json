{
  "name": "PremiumWorkspace.json",
  "dataColors": [
    "#50D5CB",
    "#F28B73",
    "#708BFF",
    "#E7B450",
    "#BC8AE8",
    "#478DAB"
  ],
  "background": "#FFFFFF",
  "foreground": "#263650",
  "tableAccent": "#50D5CB",
  "textClasses": {
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 11,
      "color": "#53647E"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 13,
      "color": "#263650"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 27,
      "color": "#17263D"
    }
  },
  "visualStyles": {
    "tableEx": {
      "*": {
        "values": [
          {
            "fontSize": 11
          }
        ],
        "columnHeaders": [
          {
            "fontSize": 11,
            "bold": true
          }
        ],
        "grid": [
          {
            "rowPadding": 7
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 3
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "show": false
          }
        ]
      }
    }
  }
}